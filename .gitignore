.local/
/target
/dist
.trunk/

# Terraform. The .terraform.lock.hcl files are committed — they are the provider
# pin — but nothing below is.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Carries the AWS account id, which is deliberately kept out of this repository.
# infra/backend.hcl.example is the template.
/infra/backend.hcl

# bootstrap ships with a local backend so its first apply can create the state
# bucket. backend.tf appears only after that migration — see
# infra/bootstrap/backend.tf.example.
/infra/bootstrap/backend.tf

# DynamoDB Local writes this into the working directory — an installation id and
# a telemetry flag, written even with -inMemory. `just dynamo` passes
# -disableTelemetry and so produces no such file; this stays for the jar run by
# hand without it.
dynamodb-local-metadata.json
